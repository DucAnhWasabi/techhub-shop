Users -> DB : BEGIN
Users -> DB : INSERT users
Users -> DB : INSERT default address
Users -> DB : COMMIT
API -> Redis : Save authenticated session
API --> Browser : 201 user data
Browser --> Customer : Redirect to /account
@enduml

