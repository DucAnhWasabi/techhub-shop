<!doctype html>
<html lang="vi"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chi tiết sản phẩm — TechHub</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/css/site.css" rel="stylesheet">
</head><body>
  <nav class="navbar navbar-expand-lg navbar-dark border-bottom border-secondary-subtle"><div class="container py-2"><a class="navbar-brand fw-bold" href="/">TECHHUB<span>.</span></a><a class="btn btn-outline-light btn-sm" href="/products">Catalog</a></div></nav>
  <main class="container py-4"><div class="small text-secondary mb-3"><a href="/">Trang chủ</a> / <span id="crumb-category">Sản phẩm</span></div>
    <div id="product-error" class="alert alert-warning d-none"></div><div id="product-detail" class="row g-4"></div>
    <section class="mt-5"><div class="section-heading"><div><div class="eyebrow">PRODUCT FEEDBACK</div><h2 class="h3">Nhận xét & đánh giá</h2></div><div id="rating-summary" class="rating-summary"></div></div>
      <div class="row g-4"><div class="col-lg-5"><div class="auth-panel p-4 rounded-4"><h3 class="h5">Viết bình luận</h3><form id="review-form"><div id="review-name-wrap"><label class="form-label" for="review-name">Tên hiển thị</label><input id="review-name" class="form-control mb-3" minlength="2" maxlength="80" required></div><label class="form-label" for="review-body">Bình luận</label><textarea id="review-body" class="form-control mb-3" rows="4" minlength="3" maxlength="2000" required></textarea><button class="btn btn-info fw-semibold">Gửi bình luận</button></form>
        <hr class="border-secondary my-4"><h3 class="h5">Đánh giá sao</h3><p id="rating-hint" class="small text-secondary"><a href="/login">Đăng nhập</a> customer để gửi đánh giá. Không yêu cầu đã mua hàng.</p><form id="rating-form" class="d-flex align-items-center gap-3"><select id="stars" class="form-select" aria-label="Số sao"><option value="5">★★★★★ — 5 sao</option><option value="4">★★★★☆ — 4 sao</option><option value="3">★★★☆☆ — 3 sao</option><option value="2">★★☆☆☆ — 2 sao</option><option value="1">★☆☆☆☆ — 1 sao</option></select><button class="btn btn-outline-info text-nowrap">Gửi sao</button></form></div></div>
      <div class="col-lg-7"><div id="review-notice" class="alert d-none"></div><div id="reviews" class="d-grid gap-2"></div><nav class="pager mt-3" id="review-pagination" aria-label="Trang bình luận"></nav></div></div>
    </section>
  </main><footer class="container py-4 text-secondary small border-top border-secondary-subtle">© TechHub</footer>
  <script src="/socket.io/socket.io.js"></script><script src="/assets/js/product.js" defer></script>
</body></html>
