<!doctype html>
<html lang="vi"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — TechHub</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/css/site.css" rel="stylesheet">
</head><body data-page="<%= mode %>">
  <nav class="navbar navbar-dark border-bottom border-secondary-subtle"><div class="container py-2"><a class="navbar-brand fw-bold" href="/">TECHHUB<span>.</span></a><a href="/" class="text-info text-decoration-none">← Về cửa hàng</a></div></nav>
  <main class="container py-5"><div class="auth-panel mx-auto p-4 p-md-5 rounded-4">
    <div class="eyebrow">TECHHUB ACCOUNT</div><h1 class="h2 mt-2 mb-4"><%= title %></h1>
    <div id="notice" class="alert d-none" role="alert"></div>
    <% if (mode === 'register') { %>
      <form id="register-form" novalidate>
        <label class="form-label" for="fullName">Họ tên</label><input class="form-control mb-3" id="fullName" name="fullName" required minlength="2" maxlength="100" autocomplete="name">
        <label class="form-label" for="email">Email</label><input class="form-control mb-3" id="email" name="email" type="email" required autocomplete="email">
        <label class="form-label" for="address">Địa chỉ giao hàng</label><textarea class="form-control mb-3" id="address" name="address" required minlength="5" maxlength="300" rows="3" autocomplete="street-address"></textarea>
        <label class="form-label" for="password">Mật khẩu</label><input class="form-control mb-4" id="password" name="password" type="password" required minlength="10" maxlength="128" autocomplete="new-password">
        <button class="btn btn-info w-100 fw-semibold">Tạo tài khoản</button>
      </form><p class="small text-secondary mt-3 mb-0">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
    <% } else if (mode === 'login') { %>
      <form id="login-form" novalidate>
        <label class="form-label" for="email">Email</label><input class="form-control mb-3" id="email" name="email" type="email" required autocomplete="email">
        <label class="form-label" for="password">Mật khẩu</label><input class="form-control mb-4" id="password" name="password" type="password" required autocomplete="current-password">
        <button class="btn btn-info w-100 fw-semibold">Đăng nhập</button>
      </form>
      <div class="text-center text-secondary my-3">hoặc tiếp tục với</div>
      <div id="oauth-buttons" class="d-flex gap-2"><a class="btn btn-outline-light flex-fill" href="/api/auth/google">Google</a><a class="btn btn-outline-light flex-fill" href="/api/auth/facebook">Facebook</a></div>
      <div id="oauth-note" class="small text-secondary mt-2 d-none">Quản trị viên chưa cấu hình OAuth trong tệp .env.</div>
      <div class="d-flex justify-content-between small mt-3"><a href="/forgot-password">Quên mật khẩu?</a><a href="/register">Tạo tài khoản</a></div>
    <% } else if (mode === 'forgot') { %>
      <p class="text-secondary">Nhập email để nhận liên kết đặt lại mật khẩu nếu tài khoản tồn tại.</p>
      <form id="forgot-form" novalidate><label class="form-label" for="email">Email</label><input class="form-control mb-4" id="email" name="email" type="email" required autocomplete="email"><button class="btn btn-info w-100 fw-semibold">Gửi hướng dẫn</button></form>
      <p class="small mt-3"><a href="/login">Quay lại đăng nhập</a></p>
    <% } else { %>
      <p class="text-secondary">Liên kết chỉ dùng một lần và hết hạn sau 30 phút.</p>
      <form id="reset-form" novalidate><input id="token" type="hidden"><label class="form-label" for="password">Mật khẩu mới</label><input class="form-control mb-4" id="password" type="password" required minlength="10" maxlength="128" autocomplete="new-password"><button class="btn btn-info w-100 fw-semibold">Đặt mật khẩu</button></form>
      <p class="small mt-3"><a href="/login">Quay lại đăng nhập</a></p>
    <% } %>
  </div></main>
  <script src="/assets/js/auth.js" defer></script>
</body></html>
