<!doctype html>
<html lang="vi"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> — TechHub</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/css/site.css" rel="stylesheet">
</head><body data-category="<%= categorySlug %>">
  <nav class="navbar navbar-expand-lg navbar-dark border-bottom border-secondary-subtle"><div class="container py-2">
    <a class="navbar-brand fw-bold" href="/">TECHHUB<span>.</span></a>
    <form class="search-bar d-flex gap-2 flex-grow-1 mx-lg-4" action="/search" method="get"><input class="form-control" type="search" name="q" placeholder="Tìm sản phẩm…" maxlength="100"><button class="btn btn-info btn-sm">Tìm</button></form>
    <a class="btn btn-outline-light btn-sm me-2" href="/cart">Giỏ hàng</a><a class="btn btn-outline-light btn-sm" href="/account">Tài khoản</a>
  </div></nav>
  <main class="container py-4"><div class="eyebrow">TECHHUB CATALOG</div><div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4"><h1 class="h2 mb-0" id="catalog-title"><%= pageTitle %></h1><div id="result-count" class="small text-secondary"></div></div>
    <div id="catalog-error" class="alert alert-warning d-none"></div>
    <div class="row g-4"><aside class="col-lg-3"><form id="filters" class="filter-panel p-3 rounded-4">
      <h2 class="h6 mb-3">Lọc sản phẩm</h2>
      <label class="form-label" for="category">Danh mục</label><select class="form-select mb-3" id="category"><option value="">Tất cả danh mục</option></select>
      <label class="form-label" for="brand">Thương hiệu</label><select class="form-select mb-3" id="brand"><option value="">Tất cả thương hiệu</option></select>
      <label class="form-label">Khoảng giá (đ)</label><div class="d-flex gap-2 mb-3"><input class="form-control" id="minPrice" type="number" min="0" placeholder="Từ"><input class="form-control" id="maxPrice" type="number" min="0" placeholder="Đến"></div>
      <label class="form-check-label mb-3"><input class="form-check-input me-2" id="inStock" type="checkbox">Chỉ xem hàng còn</label>
      <label class="form-label" for="sort">Sắp xếp</label><select class="form-select mb-3" id="sort"><option value="name_asc">Tên A–Z</option><option value="name_desc">Tên Z–A</option><option value="price_asc">Giá tăng dần</option><option value="price_desc">Giá giảm dần</option><option value="newest">Mới nhất</option><option value="best_sellers">Bán chạy</option></select>
      <div class="d-flex gap-2"><button class="btn btn-info flex-fill">Áp dụng</button><button class="btn btn-outline-light" id="clear-filters" type="button">Xóa</button></div>
    </form></aside><section class="col-lg-9">
      <div class="catalog-toolbar"><div class="small text-secondary">Hiển thị <span id="view-range">—</span></div><div class="btn-group btn-group-sm"><button type="button" class="btn btn-outline-light active" data-view="grid">Lưới</button><button type="button" class="btn btn-outline-light" data-view="list">Danh sách</button></div></div>
      <div class="row g-3" id="catalog-products"></div><nav id="pagination" class="pager mt-4" aria-label="Phân trang sản phẩm"></nav>
    </section></div>
  </main>
  <footer class="container py-4 text-secondary small border-top border-secondary-subtle">© TechHub</footer>
  <script src="/assets/js/catalog.js" defer></script>
</body></html>
