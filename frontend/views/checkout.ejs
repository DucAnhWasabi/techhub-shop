<!doctype html><html lang="vi"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Checkout — TechHub</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/assets/css/site.css" rel="stylesheet">
</head><body><nav class="navbar navbar-dark border-bottom border-secondary-subtle"><div class="container py-2"><a class="navbar-brand fw-bold" href="/">TECHHUB<span>.</span></a><a class="btn btn-outline-light btn-sm" href="/cart">← Giỏ hàng</a></div></nav>
<main class="container py-5"><div class="eyebrow">SECURE CHECKOUT</div><h1 class="h2 mb-4">Hoàn tất đơn hàng</h1><div class="checkout-steps mb-4"><span class="active" data-step-indicator="1">1 · Giao hàng</span><span data-step-indicator="2">2 · Ưu đãi</span><span data-step-indicator="3">3 · Xác nhận</span></div>
  <div id="checkout-notice" class="alert d-none"></div><div id="checkout-done" class="auth-panel p-4 rounded-4 d-none"></div>
  <form id="checkout-form" novalidate>
    <section class="checkout-step auth-panel p-4 rounded-4" data-step="1"><h2 class="h5 mb-3">Thông tin người nhận</h2>
      <div id="guest-contact"><label class="form-label" for="email">Email nhận xác nhận đơn</label><input class="form-control mb-3" id="email" type="email" autocomplete="email" required>
        <label class="form-label" for="fullName">Họ tên</label><input class="form-control mb-3" id="fullName" autocomplete="name" required minlength="2" maxlength="100"></div>
      <div id="saved-address-section" class="d-none mb-3"><label class="form-label" for="address-select">Địa chỉ đã lưu</label><select id="address-select" class="form-select"><option value="custom">Nhập địa chỉ khác</option></select></div>
      <div id="address-fields" class="row g-2"><div class="col-md-6"><label class="form-label" for="recipientName">Tên người nhận</label><input class="form-control" id="recipientName" required minlength="2"></div>
        <div class="col-md-6"><label class="form-label" for="phone">Số điện thoại</label><input class="form-control" id="phone" inputmode="tel" required></div>
        <div class="col-12"><label class="form-label" for="line1">Địa chỉ</label><input class="form-control" id="line1" required minlength="5" autocomplete="street-address"></div><div class="col-12"><label class="form-label" for="line2">Căn hộ/tòa nhà (không bắt buộc)</label><input class="form-control" id="line2"></div>
        <div class="col-md-6"><label class="form-label" for="ward">Phường/xã</label><input class="form-control" id="ward"></div><div class="col-md-6"><label class="form-label" for="district">Quận/huyện</label><input class="form-control" id="district"></div>
        <div class="col-md-6"><label class="form-label" for="province">Tỉnh/thành phố</label><input class="form-control" id="province" required minlength="2"></div><div class="col-md-6"><label class="form-label" for="postalCode">Mã bưu chính</label><input class="form-control" id="postalCode"></div>
      </div><button type="button" class="btn btn-info mt-4" id="step-1-next">Tiếp tục</button>
    </section>
    <section class="checkout-step auth-panel p-4 rounded-4 d-none" data-step="2"><h2 class="h5 mb-3">Mã giảm giá và điểm thưởng</h2>
      <div class="row g-3"><div class="col-md-6"><label class="form-label" for="discountCode">Mã giảm giá (5 ký tự)</label><div class="input-group"><input id="discountCode" class="form-control" maxlength="5" placeholder="TECH5"><button class="btn btn-outline-info" type="button" id="apply-coupon">Áp dụng</button></div></div>
        <div class="col-md-6"><label class="form-label" for="pointsToRedeem">Điểm muốn dùng <span id="available-points" class="text-secondary"></span></label><input id="pointsToRedeem" class="form-control" type="number" min="0" step="1" value="0"></div></div>
      <div id="quote-summary" class="mt-4"></div><div class="d-flex gap-2 mt-4"><button type="button" class="btn btn-outline-light" data-back="1">Quay lại</button><button type="button" class="btn btn-info" id="step-2-next">Xem lại đơn</button></div>
    </section>
    <section class="checkout-step auth-panel p-4 rounded-4 d-none" data-step="3"><h2 class="h5 mb-3">Xác nhận đơn hàng</h2><div id="order-review"></div><div class="mt-4"><strong>Thanh toán</strong><div class="text-secondary mt-1">Thanh toán khi nhận hàng (COD)</div></div>
      <div class="d-flex flex-wrap gap-2 mt-4"><button type="button" class="btn btn-outline-light" data-back="2">Quay lại</button><button type="submit" id="place-order" class="btn btn-info fw-semibold">Đặt hàng</button></div>
    </section>
  </form>
</main><footer class="container py-4 text-secondary small border-top border-secondary-subtle">© TechHub</footer><script src="/assets/js/checkout.js" defer></script></body></html>
