<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TechHub — Máy tính & linh kiện</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/css/site.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark border-bottom border-secondary-subtle">
    <div class="container py-2"><a class="navbar-brand fw-bold" href="/">TECHHUB<span>.</span></a>
      <div class="d-flex align-items-center gap-3"><span class="navbar-text d-none d-md-inline">Máy tính & linh kiện chính hãng</span>
      <a class="btn btn-outline-info btn-sm" href="/login">Đăng nhập</a><a class="btn btn-info btn-sm fw-semibold" href="/register">Đăng ký</a></div></div>
  </nav>
  <main class="container py-5">
    <section class="hero rounded-4 p-4 p-lg-5 mb-5">
      <div class="eyebrow mb-3">BUILD YOUR NEXT</div>
      <h1 class="display-4 fw-bold">Cấu hình đúng.<br><span>Hiệu năng vượt trội.</span></h1>
      <p class="lead mt-3 mb-4">Laptop, màn hình và linh kiện máy tính được tuyển chọn cho góc làm việc của bạn.</p>
      <form class="search-bar d-flex gap-2 mt-4" action="/search" method="get"><input class="form-control form-control-lg" type="search" name="q" placeholder="Tìm laptop, RAM, CPU, màn hình…" required maxlength="100"><button class="btn btn-info btn-lg fw-semibold">Tìm kiếm</button></form>
    </section>
    <section class="mb-5" id="new-section"><div class="section-heading"><div><div class="eyebrow">FRESH ARRIVALS</div><h2 class="h3">Sản phẩm mới</h2></div><a href="/products?sort=newest">Xem catalog →</a></div><div class="row g-3" id="new-products"></div><nav class="pager mini-pager" id="new-pagination" aria-label="Trang sản phẩm mới"></nav></section>
    <section class="mb-5" id="best-section"><div class="section-heading"><div><div class="eyebrow">COMMUNITY FAVORITES</div><h2 class="h3">Bán chạy</h2></div><a href="/products?sort=best_sellers">Xem catalog →</a></div><div class="row g-3" id="best-products"></div><nav class="pager mini-pager" id="best-pagination" aria-label="Trang bán chạy"></nav></section>
    <section><div class="section-heading"><div><div class="eyebrow">BUILD YOUR SETUP</div><h2 class="h3">Khám phá danh mục</h2></div></div><div class="row g-3" id="categories"></div></section>
  </main>
  <footer class="container py-4 text-secondary small border-top border-secondary-subtle">© TechHub — Đồ án Web Programming with Node.js</footer>
  <script src="/assets/js/home.js" defer></script>
</body>
</html>
