<!doctype html>
<html lang="vi"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tài khoản — TechHub</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/css/site.css" rel="stylesheet">
</head><body>
  <nav class="navbar navbar-dark border-bottom border-secondary-subtle"><div class="container py-2"><a class="navbar-brand fw-bold" href="/">TECHHUB<span>.</span></a><button id="logout" class="btn btn-outline-light btn-sm">Đăng xuất</button></div></nav>
  <main class="container py-5"><div class="d-flex justify-content-between align-items-end mb-4"><div><div class="eyebrow">ACCOUNT CENTER</div><h1 class="h2 mb-0">Tài khoản của bạn</h1></div><a href="/orders" class="btn btn-outline-info">Lịch sử mua hàng</a></div>
    <div id="notice" class="alert d-none" role="alert"></div>
    <div class="row g-4"><div class="col-lg-5"><section class="auth-panel p-4 rounded-4">
      <h2 class="h5 mb-3">Hồ sơ</h2><div id="profile-summary" class="text-secondary mb-3">Đang tải…</div>
      <form id="profile-form"><label class="form-label" for="fullName">Họ tên</label><input class="form-control mb-3" id="fullName" required minlength="2" maxlength="100"><button class="btn btn-outline-info">Cập nhật hồ sơ</button></form>
      <hr class="border-secondary my-4"><h2 class="h5 mb-3">Đổi mật khẩu</h2>
      <form id="password-form"><label class="form-label" for="currentPassword">Mật khẩu hiện tại</label><input class="form-control mb-3" id="currentPassword" type="password" required autocomplete="current-password"><label class="form-label" for="newPassword">Mật khẩu mới</label><input class="form-control mb-3" id="newPassword" type="password" required minlength="10" maxlength="128" autocomplete="new-password"><button class="btn btn-outline-info">Đổi mật khẩu</button></form>
    </section></div><div class="col-lg-7"><section class="auth-panel p-4 rounded-4">
      <h2 class="h5 mb-3">Địa chỉ giao hàng</h2><div id="addresses" class="d-grid gap-2 mb-4"></div>
      <h3 class="h6">Thêm địa chỉ</h3><form id="address-form" class="row g-2"><input type="hidden" name="addressId" value="">
        <div class="col-md-6"><input class="form-control" name="recipientName" placeholder="Tên người nhận" required minlength="2"></div>
        <div class="col-md-6"><input class="form-control" name="phone" placeholder="Số điện thoại (không bắt buộc)"></div>
        <div class="col-12"><input class="form-control" name="line1" placeholder="Địa chỉ" required minlength="5"></div>
        <div class="col-md-6"><input class="form-control" name="ward" placeholder="Phường/xã"></div>
        <div class="col-md-6"><input class="form-control" name="district" placeholder="Quận/huyện"></div>
        <div class="col-md-6"><input class="form-control" name="province" placeholder="Tỉnh/thành phố" required minlength="2"></div>
        <div class="col-md-6"><input class="form-control" name="postalCode" placeholder="Mã bưu chính"></div>
        <div class="col-12"><label class="form-check-label"><input class="form-check-input me-2" name="isDefault" type="checkbox">Đặt làm địa chỉ mặc định</label></div>
        <div class="col-12 d-flex gap-2"><button class="btn btn-info fw-semibold">Lưu địa chỉ</button><button id="cancel-address-edit" type="button" class="btn btn-outline-light d-none">Hủy sửa</button></div>
      </form>
    </section></div></div>
  </main><script src="/assets/js/account.js" defer></script>
</body></html>
